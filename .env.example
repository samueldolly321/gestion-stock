# === PostgreSQL ===
SQL_HOST=localhost
SQL_PORT=5432
SQL_DB_NAME=stock
SQL_USER=user
SQL_PASSWORD=user
# Compte avec droits CREATE, utilisé pour appliquer les migrations Drizzle
# (peut être identique à SQL_USER s'il a les droits sur la base).
SQL_ADMIN_USER=user
SQL_ADMIN_PASSWORD=user

# === Serveur API ===
PORT=3001
# Secret de signature des jetons JWT (auth). Mettre une valeur aléatoire en production.
JWT_SECRET=change-me-super-secret-key

# URL du front (utilisée pour le CORS et le flux temps réel SSE)
APP_URL=http://localhost:3000
